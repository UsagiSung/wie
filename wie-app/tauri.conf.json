{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pocket Library",
  "version": "0.1.4",
  "identifier": "io.github.usagisung.pocketlibrary",
  "build": {
    "frontendDist": "../wie-web/dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build:prod"
  },
  "app": {
    "windows": [
      {
        "title": "Pocket Library",
        "width": 1200,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "default",
          "description": "enables the default permissions",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default"
          ]
        }
      ],
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; media-src 'self' blob:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/Square310x310Logo.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "피처폰 게임 라이브러리"
  }
}
